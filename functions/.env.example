# Paramètres NON secrets des Cloud Functions (copier en functions/.env, non versionné).
# Les secrets se règlent avec : firebase functions:secrets:set PAYPAL_CLIENT_ID
#                               firebase functions:secrets:set PAYPAL_CLIENT_SECRET

# "sandbox" pour tester avec des comptes PayPal fictifs, "live" pour les vrais paiements.
# Toute autre valeur désactive les paiements. Les secrets PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET
# doivent appartenir au MÊME environnement (identifiants Sandbox ≠ identifiants Live). Voir docs/paypal.md.
PAYPAL_ENV=sandbox

# Origines autorisées à appeler les fonctions, séparées par des virgules
# (ex. https://<utilisateur>.github.io ou votre domaine). Sans barre finale.
# En mode live, seules les origines https:// sont prises en compte.
ALLOWED_ORIGINS=http://localhost:5173

# Identifiant du webhook créé dans le tableau de bord développeur PayPal, pour le MÊME environnement
# (événements CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.PENDING,
# PAYMENT.CAPTURE.DECLINED). Vide = webhook désactivé (recommandé de le configurer).
PAYPAL_WEBHOOK_ID=

# Envoi des messages du formulaire de contact (SMTP). Le mot de passe est un SECRET :
#   firebase functions:secrets:set SMTP_PASSWORD   (Gmail : mot de passe d'application)
# Sans SMTP_USER ni secret, le formulaire répond « service non configuré » (aucun envoi simulé).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=krimossimo.contact@gmail.com
CONTACT_TO=krimossimo.contact@gmail.com
