# Copie ce fichier en ".env.local" et remplis les valeurs.
# Toutes les variables VITE_* sont intégrées au JavaScript public :
# n'y mets JAMAIS de secret (clé privée, client secret PayPal, clé admin...).
# La configuration web Firebase et le client ID PayPal sont publics par conception ;
# la sécurité repose sur les règles Firestore/Storage et sur les Cloud Functions.
# Aucune valeur réelle n'est fournie ici : voir docs/firebase.md pour les obtenir.

# Configuration web Firebase (console Firebase > Paramètres du projet > Vos applications > Web).
# Toutes vides = Firebase désactivé : contenu local, administration indisponible.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Émulateurs locaux (npm run emulators) : "true" connecte Auth, Firestore et Storage aux
# émulateurs, UNIQUEMENT avec `npm run dev` (ignoré dans un build de production).
# Avec les émulateurs, utilisez un identifiant de projet de démonstration : demo-krimossimo.
VITE_FIREBASE_EMULATORS=

# Source du contenu : Firestore est utilisé automatiquement si Firebase est configuré.
# Mettre "local" pour forcer les fichiers de src/data/ (utile pour tester).
VITE_CONTENT_SOURCE=

# Données de démonstration (src/data/demo/, badge « Démo ») ajoutées à la source locale.
# Vide = actives avec `npm run dev`, absentes du build de production.
# "true" les force (même en production), "false" les désactive partout.
VITE_DEMO_CONTENT=

# URL publique des Cloud Functions de commande (https obligatoire, sauf http://localhost pour l'émulateur).
# ex. https://europe-west1-<projet>.cloudfunctions.net
# Vide = le panier fonctionne, mais aucune commande n'est créée (le formulaire l'indique).
VITE_FUNCTIONS_BASE_URL=

# URL publique du service d'envoi du formulaire de contact : la fonction submitContact,
# ex. https://europe-west1-<projet>.cloudfunctions.net/submitContact
# Vide = le formulaire valide la saisie mais n'envoie rien et l'indique à l'utilisateur.
VITE_CONTACT_ENDPOINT=

# Envoi GRATUIT du formulaire de contact par Web3Forms (sans Cloud Function, sans Blaze).
# Clé créée sur https://web3forms.com avec l'adresse qui doit recevoir les messages.
# Publique par conception (elle n'envoie que vers cette adresse). Prioritaire sur VITE_CONTACT_ENDPOINT.
VITE_WEB3FORMS_ACCESS_KEY=

# Clé d'API Google pour les dernières vidéos YouTube (page Activités). Pas un secret, mais elle DOIT
# être restreinte dans Google Cloud : sites autorisés = adresse du site, API = YouTube Data API v3.
# Vide = la page affiche la liste manuelle (src/data/videos.ts) sans contacter YouTube.
# Voir docs/integrations.md.
VITE_YOUTUBE_API_KEY=

# PayPal : AUCUNE variable ici. Le client ID (public) et l'environnement sandbox/live sont
# fournis par les Cloud Functions avec chaque commande ; le secret reste côté serveur
# (firebase functions:secrets:set PAYPAL_CLIENT_SECRET). Voir docs/paypal.md.
# (vite.config.ts refuse toute variable VITE_* nommée *SECRET*, *PRIVATE*, *PASSWORD*, *TOKEN*...).
